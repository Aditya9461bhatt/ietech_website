rules_version = '2';

// Firestore security rules for the ietech.ai website.
//
// SECURITY MODEL
// --------------
// Site content lives as files in the repo (see /content) and the CMS is a
// local-only tool — Firestore's sole remaining job is receiving contact-form
// leads. Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // Content (blogs / case studies) now lives as files in the repo and is
    // baked into the site at build time — these collections are unused and
    // fully locked. (Kept as an explicit deny in case old data remains.)
    match /blogs/{docId} {
      allow read, write: if false;
    }

    match /case_studies/{docId} {
      allow read, write: if false;
    }

    // Contact form: the public may CREATE a lead, but nobody may read, update,
    // or delete leads from the client. Reads happen server-side / in the console.
    // The shape check stops the collection from being abused as free storage.
    match /contact_submissions/{docId} {
      allow read, update, delete: if false;
      allow create: if isValidLead();
    }

    function isValidLead() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'phone', 'createdAt'])
        && d.email is string
        && d.email.size() > 3
        && d.email.size() < 254
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (!('phone' in d) || (d.phone is string && d.phone.size() < 32))
        && d.createdAt is string;
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
